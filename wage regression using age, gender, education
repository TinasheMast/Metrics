# Using the USA CPS data for aug 2026 to do a regression using education, gender, and age as regressors and 
# salary as the dependent variable. We use two dummy variables for education. 

library(readr)
aug26pub <- read_csv("Downloads/aug26pub.csv")
variable_needed_for_regression <- aug26pub %>% select(prtage, pesex, peeduca, pternwa)
View(variable_needed_for_regression)
variable_needed_for_regression <- aug26pub %>% select(prtage, pesex, peeduca, pternwa, prerelg)
# I know i need prerelg to be equal to 1 so that I am only looking at people who were surveyed
#I also know that i need to restrict weekly earnings to positive (pternwa) numbers

data_frame= subset(variable_needed_for_regression, prerelg== 1 & pternwa >0)

View(data_frame)  
dim(data_frame)
data_frame$earn = data_frame$pternwa
data_frame$lnearn = log(data_frame$earn)
# education dummy variables are some highschool/associate and bachelors or higher and the base for comparison is any education lower than
# highschool or associate

data_frame$high_school = as.numeric(data_frame$peeduca>=39 & data_frame$peeduca<=42)
data_frame$bachelors_plus = as.numeric(data_frame$peeduca>=43)

data_frame$female = as.numeric(data_frame$pesex==2)

data_frame$female = as.numeric(data_frame$pesex==2) # sets the male = 0, f = 1
data_frame$age = data_frame$prtage

linear_regression_model = lm(lnearn~female +age+high_school+bachelors_plus, data=data_frame)

summary(linear_regression_model)
  
